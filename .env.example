# 서울 공공 API
SEOUL_API_KEY=

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# JWT (Base64 인코딩된 256비트 이상 시크릿)
JWT_SECRET=

# CORS (쉼표 구분, 프론트엔드 도메인)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Swagger UI (로컬 개발 시 true, 프로덕션은 false)
SWAGGER_ENABLED=false

# Kafka (Docker Compose 사용 시 기본값 유지)
# SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
