# =============================================
# MetroHub 프로덕션 환경변수
# 이 파일을 .env로 복사하고 값을 채우세요
# cp .env.prod.example .env
# =============================================

# 서울 열린데이터광장 - 실시간 지하철인증키
SEOUL_API_KEY=여기에_서울_API_키_입력

# MySQL 비밀번호 (강력한 비밀번호로 변경하세요)
MYSQL_ROOT_PASSWORD=여기에_루트_비밀번호_입력
MYSQL_PASSWORD=여기에_metrohub_비밀번호_입력

# JWT 시크릿 (Base64 인코딩, 최소 32자 원문 기준)
# 생성 방법: echo -n "랜덤32자이상문자열" | base64
JWT_SECRET=여기에_Base64_인코딩된_JWT_시크릿_입력
