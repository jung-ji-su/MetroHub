<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.metrohub.api.domain.complaint.ComplaintMapper">

    <resultMap id="ComplaintResultMap" type="com.metrohub.api.domain.complaint.Complaint">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="category" column="category"/>
        <result property="stationName" column="station_name"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO complaints (user_id, category, station_name, content, status, created_at)
        VALUES (#{userId}, #{category}, #{stationName}, #{content}, #{status}, NOW())
    </insert>

    <select id="findById" resultMap="ComplaintResultMap">
        SELECT * FROM complaints WHERE id = #{id}
    </select>

    <select id="findByUserId" resultMap="ComplaintResultMap">
        SELECT * FROM complaints WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <select id="findAll" resultMap="ComplaintResultMap">
        SELECT * FROM complaints
        <where>
            <if test="status != null and status != ''">
                status = #{status}
            </if>
        </where>
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM complaints
        <where>
            <if test="status != null and status != ''">
                status = #{status}
            </if>
        </where>
    </select>

    <update id="updateStatus">
        UPDATE complaints SET status = #{status} WHERE id = #{id}
    </update>

    <delete id="deleteByIdAndUserId">
        DELETE FROM complaints WHERE id = #{id} AND user_id = #{userId}
    </delete>

</mapper>
